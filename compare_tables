WITH warehouse_costs AS (
  -- Step 1: Get total DBU consumption per warehouse per day
  SELECT 
    usage_date,
    usage_metadata.warehouse_id,
    SUM(usage_quantity) as total_dbus
  FROM system.billing.usage
  WHERE billing_origin_product = 'SQL'
    AND usage_date >= CURRENT_DATE - INTERVAL 30 DAYS
  GROUP BY 1, 2
),
user_query_activity AS (
  -- Step 2: Get total query duration per user per warehouse per day
  -- Note: This uses the Query History system table
  SELECT 
    DATE(total_duration_ms) as usage_date,
    warehouse_id,
    executed_by as user_email,
    SUM(total_duration_ms) as user_total_duration
  FROM system.query_analytics.query_history
  WHERE executed_by = 'user@example.com' -- <--- Filter specific user here
    AND start_time >= CURRENT_DATE - INTERVAL 30 DAYS
  GROUP BY 1, 2, 3
),
total_warehouse_activity AS (
  -- Step 3: Get total duration for ALL users to calculate the ratio
  SELECT 
    DATE(start_time) as usage_date,
    warehouse_id,
    SUM(total_duration_ms) as global_total_duration
  FROM system.query_analytics.query_history
  WHERE start_time >= CURRENT_DATE - INTERVAL 30 DAYS
  GROUP BY 1, 2
)
-- Step 4: Combine to find the attributed DBUs
SELECT 
  u.usage_date,
  u.user_email,
  u.warehouse_id,
  (u.user_total_duration / t.global_total_duration) * w.total_dbus as attributed_dbus
FROM user_query_activity u
JOIN total_warehouse_activity t 
  ON u.usage_date = t.usage_date AND u.warehouse_id = t.warehouse_id
JOIN warehouse_costs w 
  ON u.usage_date = w.usage_date AND u.warehouse_id = w.warehouse_id
ORDER BY u.usage_date DESC;
